+def is_poetry(snippet):
+    lines = snippet.strip().split('\n')
+    if len(lines) < 3:
+        return False
+    line_lengths = [len(line.strip()) for line in lines]
+    average_length = sum(line_lengths) / len(line_lengths)
+    # Simple heuristic for poetry
+    if average_length < 60 and (max(line_lengths) - min(line_lengths) < 20):
+        return True
+    return False
+
+def find_exact_match_in_text(original_text, query):
+    """
+    Attempt exact phrase match:
+    1. With punctuation intact.
+    2. If not found, remove punctuation from both text and query and try again.
+    Returns start_index or -1 if not found.
+    """
+    norm_text = prepare_text_for_matching(original_text)
+    norm_query = prepare_text_for_matching(query)
+
+    # Try with punctuation
+    start_index = norm_text.find(norm_query)
+    if start_index != -1:
+        return start_index
+
+    # Try without punctuation
+    text_no_punc = remove_punctuation(norm_text)
+    query_no_punc = remove_punctuation(norm_query)
+    start_index_no_punc = text_no_punc.find(query_no_punc)
+    return start_index_no_punc
+
+def create_snippet_around_match(text, start_index, query, max_chars=500):
+    """
+    Given start_index of the match in text, create a snippet around it.
+    No highlighting, just return the snippet.
+    """
+    snippet_start = max(0, start_index - 200)
+    snippet_end = min(len(text), start_index + len(query) + 300)
+    snippet = text[snippet_start:snippet_end]
+
+    # Check if snippet is poetry
+    poem = is_poetry(snippet)
+
+    # Convert line breaks
+    if poem:
+        snippet = snippet.replace('\n', '<br>')
+    else:
+        snippet = snippet.replace('\n', ' ')
+
+    # Clean multiple spaces
+    snippet = re.sub(r'\s+', ' ', snippet)
+    snippet = snippet[:max_chars].strip()
+
+    # No <mark>, just return snippet
+    return snippet
 
