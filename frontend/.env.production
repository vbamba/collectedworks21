# CHANGED: REACT_APP_* -> VITE_* — Vite only exposes import.meta.env vars
# that start with VITE_ (CRA used the REACT_APP_ prefix via process.env).
VITE_BACKEND_URL=/api
VITE_BACKEND_PDF_URL=
VITE_BUILD_VERSION=20260605


VITE_USE_SERVER_CHAPTER=0

# CHANGED (2026-06-05): Savitri Study nav link re-enabled, pointed at the
# canonical hostname (not the collectedworks subdomain — that one 301s and
# would just cost users a hop). NavBar.jsx renders the <li> when this var
# is set; unset it to hide the link again.
VITE_SAVITRI_WIKI_URL=https://savitri.thesunlitpath.in/
