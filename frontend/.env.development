REACT_APP_BACKEND_URL=http://127.0.0.1:5001/api
#REACT_APP_BACKEND_URL=/api
REACT_APP_BACKEND_PDF_URL=http://127.0.0.1:5001
REACT_APP_BUILD_VERSION=20250821

# CHANGED: was 1 (route search clicks to Flask's chapter.html template). Now
# 0 so dev matches prod (.env.production is already 0), and all chapter
# rendering goes through ChapterPage.jsx. Avoids the duplicate-fix drift we
# hit today with chapter.html and ChapterPage.jsx maintaining separate
# stopword lists / nav logic.
REACT_APP_USE_SERVER_CHAPTER=0

# CHANGED: Savitri wiki URL for the new top-nav "Savitri" link. Dev points
# at a local static server — run `python3 -m http.server 8000 -d savitri-wiki`
# from repo root. Prod value lives in .env.production.
REACT_APP_SAVITRI_WIKI_URL=http://localhost:8000/